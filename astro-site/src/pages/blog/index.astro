---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
---
<head>
  <title>Blog | Martin Mercer</title>
</head>

<h1>Blog</h1>
<ul>
  {posts.map(post => (
    <li>
      <a href={"/blog/" + post.slug}>{post.data.title}</a>
      <span> — {post.data.date}</span>
      <p>{post.data.description}</p>
    </li>
  ))}
</ul>
